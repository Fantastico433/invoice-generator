rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A document belongs to the account that created it. ownerId is checked on
    // read and on write, and it may never be changed afterwards, so a document
    // cannot be handed to (or claimed by) another account.
    match /documents/{documentId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerId;
      }

      allow read, delete: if isOwner();
      allow update: if isOwner() && request.resource.data.ownerId == resource.data.ownerId;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
